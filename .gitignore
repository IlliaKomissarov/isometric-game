# ============================================================
# ASSET CURATION (it.31)
# The raw asset store under public/ is ~2.5 GB across 300k+
# files (one WAV exceeds GitHub's hard 100 MB limit). Only the
# files the game actually loads at runtime are tracked — the
# whitelist below mirrors SpriteLibrary.ts + AudioManager.ts.
# ============================================================
public/assets/*

# Fully-used packs (tiles, knight hero, weapon icons)
!public/assets/(DEMO) Lords Of Pain - Old School Isometric Assets/
!public/assets/2D HD Character Knight/
!public/assets/oubliette_weapons - free/

# Infernus tiles: only the stairwell + candelabra sheet are used
!public/assets/Infernus_Tiles/
public/assets/Infernus_Tiles/*
!public/assets/Infernus_Tiles/Building_Infernus_1/
public/assets/Infernus_Tiles/Building_Infernus_1/*
!public/assets/Infernus_Tiles/Building_Infernus_1/Stairs_Inverted_1.png
!public/assets/Infernus_Tiles/Anim_Infernus_Lightsources_1.png

