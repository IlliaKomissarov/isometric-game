# ============================================================
# ASSET CURATION (it.36)
# public/assets holds ONLY runtime files: pre-baked sprite atlases
# (public/assets/atlas) and the audio the AudioManager maps. The raw
# packs (2.5 GB) were purged; scripts/purge-assets.mjs is the source of
# truth for what may live here, so nothing under public/ is ignored.
# Drop a new raw pack ELSEWHERE, bake it, commit only the atlas.
# ============================================================

# Raw asset uploads: bake into atlas/ui, never commit (1 GB+).
public/assets/test-models/
# it.112: the same rule for the `use now` drop (70 MB of .blend files, 3D source
# textures and 496 top-down catapult renders). `scripts/bake-catapult.py`,
# `scripts/bake-grassland.py` and `scripts/bake-ground.py` read it; only their
# atlas output is committed.
public/assets/use now/

# it.89: audio sources that have a shipped MP3 / downmix twin, and archives
public/assets/audio/Hope is Lost.wav
public/assets/audio/Ambience_samples/*.wav
public/assets/audio/SPX_samples/*.wav
public/assets/audio/FantasySFXSamples/
public/assets/audio/Wizards 2/*.zip
public/assets/audio/Wizards 2/*.png
public/assets/audio/*.mid
